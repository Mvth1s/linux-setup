# ~/.config/ghostty/config

# ── Apparence ────────────────────────────────────────────────
theme = Everforest Dark Hard

font-family = "JetBrainsMono Nerd Font Mono"
font-size = 13
font-feature = calt, liga

background-opacity = 0.85
background-blur = 8

window-padding-x = 14
window-padding-y = 14
window-padding-balance = true
window-padding-color = background

# 70% environ d'un écran 1920x1080 avec JetBrainsMono Nerd Font Mono 13
window-width = 169
window-height = 42

# ── Curseur ──────────────────────────────────────────────────
# cursor-style = block obligatoire pour le shader custom-shader ci-dessous
cursor-style = block
cursor-style-blink = true
custom-shader = shaders/cursor_smear_fade.glsl

# ── Performance ──────────────────────────────────────────────
gtk-single-instance = desktop
scrollback-limit = 10000000

# ── Intégration shell ────────────────────────────────────────
# Force fish directement : évite d'attendre une déconnexion/reconnexion
# de session après le changement de shell par défaut (chsh)
command = fish
shell-integration = detect
shell-integration-features = cursor,sudo,title

# ── Qualité de vie ───────────────────────────────────────────
mouse-hide-while-typing = true
clipboard-trim-trailing-spaces = true

# ── Keybindings ──────────────────────────────────────────────
keybind = ctrl+shift+h=new_split:left
keybind = ctrl+shift+l=new_split:right
keybind = ctrl+shift+j=new_split:down
keybind = ctrl+shift+k=new_split:up
keybind = ctrl+shift+t=new_tab
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab

# ── À adapter selon la machine ───────────────────────────────
# Sur KDE (desktop EndeavourOS) → décorations natives KDE :
#   gtk-titlebar = false
#
# Sur COSMIC (laptop Pop!_OS) → laisser commenté ou mettre :
gtk-titlebar = false
